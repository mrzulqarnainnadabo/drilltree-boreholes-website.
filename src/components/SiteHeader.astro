---
import { business, navigation } from '../data/site';
---
<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/images/drilltree-logo.webp" alt={`${business.name} logo`} width="160" height="48" />
    </a>
    <nav class="primary-nav" aria-label="Primary">
      {navigation.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <a class="button" href="/contact">Request a Quote</a>
  </div>
</header>
