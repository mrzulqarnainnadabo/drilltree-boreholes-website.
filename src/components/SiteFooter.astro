---
import { business, navigation } from '../data/site';
const logoSrc = "https://files.manuscdn.com/user_upload_by_module/session_file/310519663328055562/tACNtmgZOqHLdtyy.webp";
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href="/" style="display:inline-block;margin-bottom:0.75rem;">
        <img src={logoSrc} alt={`${business.name} logo`} width="140" height="42" style="height:38px;width:auto;" />
      </a>
      <p class="footer-location">{business.locationLine}</p>
      <p><a href={business.phoneHref}>{business.phoneDisplay}</a></p>
      <p class="footer-address">{business.address}</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Next step</h3>
      <p>Share the site location and intended water use. The business can confirm available next steps.</p>
      <p style="margin-top: 1rem">
        <a class="button" href="/contact">Request a Quote</a>
      </p>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
  </div>
</footer>
