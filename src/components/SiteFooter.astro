---
import { business, navigation } from '../data/site';
---
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href="/">
        <img src="/images/drilltree-logo.webp" alt={`${business.name} logo`} width="140" height="42" />
      </a>
      <p class="footer-location">{business.locationLine}</p>
      <p><a href={business.phoneHref}>{business.phoneDisplay}</a></p>
      <p class="footer-address">{business.address}</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>
        {navigation.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h3>Next step</h3>
      <p>Share the site location and intended water use. The business can confirm available next steps.</p>
      <a class="button" href="/contact/">Request a Quote</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>&copy; {new Date().getFullYear()} {business.name}. All rights reserved.</p>
  </div>
</footer>
